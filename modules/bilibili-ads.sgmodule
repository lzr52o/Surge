#!name=哔哩哔哩广告净化[墨鱼版]
#!desc=B站去广告净化，V2.0.138（2025-07-18）
#!author=@ddgksf2013
#!category=AdBlock

[Script]
bilibili_ads=type=http-response,pattern=^https?:\/\/api\.bili(api|bili)\.(net|com)\/pgc\/season\/app\/related\/recommend\?,requires-body=true,script-path=https://www.ddgksf2013.top/scripts/bilibili.ads.js,script-update-interval=0
bilibili_ads_2=type=http-response,pattern=^https?:\/\/api\.live\.bilibili\.com\/xlive\/e-commerce-interface\/v\d\/ecommerce-user\/get_shopping_info\?,requires-body=true,script-path=https://www.ddgksf2013.top/scripts/bilibili.ads.js,script-update-interval=0
bilibili_ads_3=type=http-response,pattern=^https?:\/\/api\.live\.bilibili\.com\/xlive\/app-room\/v1\/index\/getInfoByRoom,requires-body=true,script-path=https://www.ddgksf2013.top/scripts/bilibili.ads.js,script-update-interval=0
bilibili_ads_4=type=http-response,pattern=^https:\/\/app\.bilibili\.com\/x\/v2\/splash\/list,requires-body=true,script-path=https://www.ddgksf2013.top/scripts/bilibili.ads.js,script-update-interval=0
bilibili_ads_5=type=http-response,pattern=^https?:\/\/api\.live\.bilibili\.com\/xlive\/app-interface\/v2\/index\/feed,requires-body=true,script-path=https://www.ddgksf2013.top/scripts/bilibili.ads.js,script-update-interval=0
bilibili_ads_6=type=http-response,pattern=^https?:\/\/app\.bilibili\.com\/x\/v2\/feed\/index,requires-body=true,script-path=https://www.ddgksf2013.top/scripts/bilibili.ads.js,script-update-interval=0
bilibili_ads_7=type=http-response,pattern=^https?:\/\/api\.(bilibili|biliapi)\.(com|net)\/pgc\/page\/bangumi,requires-body=true,script-path=https://www.ddgksf2013.top/scripts/bilibili.ads.js,script-update-interval=0
bilibili_ads_8=type=http-response,pattern=^https?:\/\/api\.(bilibili|biliapi)\.(com|net)\/pgc\/page\/cinema\/tab\?,requires-body=true,script-path=https://www.ddgksf2013.top/scripts/bilibili.ads.js,script-update-interval=0
bilibili_ads_9=type=http-response,pattern=^https?:\/\/app\.bilibili\.com\/x\/resource\/show\/tab,requires-body=true,script-path=https://www.ddgksf2013.top/scripts/bilibili.ads.js,script-update-interval=0
bilibili_ads_10=type=http-response,pattern=^https?:\/\/app\.bilibili\.com\/x\/v2\/account\/mine,requires-body=true,script-path=https://www.ddgksf2013.top/scripts/bilibili.ads.js,script-update-interval=0
bilibili_ads_11=type=http-response,pattern=^https?:\/\/app\.bilibili\.com\/x\/resource\/top\/activity,requires-body=true,script-path=https://www.ddgksf2013.top/scripts/bilibili.ads.js,script-update-interval=0
bilibili_ads_12=type=http-response,pattern=^https://app.bilibili.com/x/v2/search/square,requires-body=true,script-path=https://www.ddgksf2013.top/scripts/bilibili.ads.js,script-update-interval=0
response_bundle=type=http-response,pattern=^https?:\/\/(grpc\.biliapi\.net|app\.bilibili\.com)\/bilibili\.polymer\.app\.search\.v1\.Search\/SearchAll$,requires-body=true,script-path=https://github.com/BiliUniverse/ADBlock/releases/download/v0.6.19/response.bundle.js,script-update-interval=0
response_bundle_2=type=http-response,pattern=^https?:\/\/(app\.bilibili\.com|grpc\.biliapi\.net)\/bilibili\.community\.service\.dm\.v1\.DM\/(DmView|DmSegMobile),requires-body=true,script-path=https://github.com/BiliUniverse/ADBlock/releases/download/v0.6.19/response.bundle.js,script-update-interval=0
response_bundle_3=type=http-response,pattern=^https:\/\/(grpc\.biliapi\.net|app\.bilibili\.com)\/bilibili\.app\.interface\.v1\.Teenagers\/ModeStatus,requires-body=true,script-path=https://github.com/BiliUniverse/ADBlock/releases/download/v0.6.19/response.bundle.js,script-update-interval=0
response_bundle_4=type=http-response,pattern=^https?:\/\/(app\.bilibili\.com|grpc\.biliapi\.net)\/bilibili\.app\.(view|viewunite)\.v1\.View\/(View|TFInfo)$,requires-body=true,script-path=https://github.com/BiliUniverse/ADBlock/releases/download/v0.6.19/response.bundle.js,script-update-interval=0
response_bundle_5=type=http-response,pattern=^https?:\/\/(app\.bilibili\.com|grpc\.biliapi\.net)\/bilibili\.app\.dynamic\.v2\.Dynamic\/Dyn(All|Video)$,requires-body=true,script-path=https://github.com/BiliUniverse/ADBlock/releases/download/v0.6.19/response.bundle.js,script-update-interval=0

[Rule]
URL-REGEX,^https?:\/\/bilibili.2025.04.02/c136,REJECT-200
URL-REGEX,^https?:\/\/api\.bilibili\.com\/pgc\/activity\/deliver\/material\/receive,REJECT-DICT
URL-REGEX,^https?:\/\/api\.bilibili\.com\/x\/vip\/ads\/material\/report,REJECT-DICT
URL-REGEX,^https://api.bilibili.com/pgc/season/player/cards,REJECT-DICT
URL-REGEX,^https?:\/\/api\.bilibili\.com\/pgc\/season\/player\/ogv\/cards,REJECT-DICT
URL-REGEX,^https://app.bilibili.com/x/v2/splash/show,REJECT-DICT
URL-REGEX,^https?:\/\/manga\.bilibili\.com\/twirp\/comic\.v\d\.Comic\/(Flash|ListFlash|GetActivityTab),REJECT-DICT
URL-REGEX,^https?:\/\/app\.bilibili\.com\/x\/v\d\/search\/defaultwords,REJECT-DICT
URL-REGEX,^https?:\/\/(app\.bilibili\.com|grpc\.biliapi\.net)\/bilibili\.app\.interface\.v1\.Search\/Default,REJECT-200
URL-REGEX,^https?:\/\/(app\.bilibili\.com|grpc\.biliapi\.net)\/bilibili\.app\.interface\.v1\.Search\/Default,REJECT

[MITM]
hostname = -broadcast.chat.bilibili.com, -cm.bilibili.com, -*cdn*.biliapi.net, -*tracker*.biliapi.net, app.bilibili.com, api.live.bilibili.com, *.bilibili.com, *.bili*.*, *.bilibili.*, grpc.biliapi.net, *biliapi.net
